# Template for local development environment variables.
# Copy this file to .env, fill in real values, and NEVER commit real
# secrets — .env is gitignored, but this template is committed so everyone
# knows which variables the app needs.

# Backend
PORT=5000
DATABASE_PATH=/data/seniorcare.db
DATA_DIR=/data/csv

# Frontend
REACT_APP_API_BASE=http://localhost:5000
